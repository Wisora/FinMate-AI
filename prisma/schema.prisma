generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum GoalCategory {
  savings
  debt
  investment
}

enum Priority {
  high
  medium
  low
}

enum PlanType {
  free
  pro
}

model User {
  id                    String         @id @default(cuid())
  email                 String         @unique
  name                  String?
  role                  String?        @default("user")
  image                 String?
  persona               String?
  monthlyIncome         Float          @default(0)
  monthlyExpensesBudget Float          @default(0)
  plan                  PlanType       @default(free)
  goals                 Goal[]
  reports               Report[]
  subscriptions         Subscription[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}

model Goal {
  id            String       @id @default(cuid())
  title         String
  category      GoalCategory @default(savings)
  targetAmount  Float
  currentAmount Float        @default(0)
  targetDate    DateTime?
  priority      Priority     @default(medium)
  isCompleted   Boolean      @default(false)
  notes         String?
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Report {
  id            String   @id @default(cuid())
  timeframe     String   // e.g. "July 2026"
  totalIncome   Float
  totalExpenses Float
  netSavings    Float
  aiSummary     String?
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Subscription {
  id            String   @id @default(cuid())
  plan          PlanType @default(free)
  status        String   // "ACTIVE", "CANCELLED", etc.
  payfastToken  String?
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}