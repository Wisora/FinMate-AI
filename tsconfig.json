{
  "compilerOptions": {
    "target": "es2019",
    "module": "commonjs",
    "rootDir": "./",          // 👈 add this line
    "outDir": "./dist",       // compiled JS goes here
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["prisma/**/*.ts", "pages/**/*.ts", "pages/**/*.tsx"],
  "exclude": ["node_modules"]
}
